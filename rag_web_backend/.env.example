# 應用設定
APP_NAME=RAG Knowledge Base
DEBUG=True
API_V1_PREFIX=/api

# 安全設定
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 資料庫
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=rag_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# 預設管理員帳號（開發環境）
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_EMAIL=superadmin@ncku.edu.tw
DEPT_ADMIN_PASSWORD=admin123

# 檔案上傳
MAX_FILE_SIZE=52428800 # 50 MB
ALLOWED_EXTENSIONS=.txt,.pdf,.doc,.docx,.xls,.xlsx
UPLOAD_DIR=/app/uploads

# CORS（⚠️ 必填，指定前端來源，多個用逗號分隔，例如：http://your-domain.com）
CORS_ORIGINS=

# Ollama 設定（請替換為您的 Ollama 服務 URL）
OLLAMA_BASE_URL=https://your-ollama-server-url
OLLAMA_SUMMARY_MODEL=qwen2.5:14b
OLLAMA_RAG_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Guard 安全過濾設定
GUARD_ENABLED=true
GUARD_MODEL=llama-guard3:8b

# 外部 API（OpenAI）預設模型（用於 /api/rag/direct-query）
OPENAI_DIRECT_MODEL=gpt-5.2

# 啟用 OpenAI Web Search（true/false）
OPENAI_ENABLE_WEB_SEARCH=false

# Google 登入設定
# 後端使用 GOOGLE_CLIENT_ID 驗證 Google ID Token
GOOGLE_CLIENT_ID=

# 前端（query）建置時注入 Google Client ID
VITE_GOOGLE_CLIENT_ID=

# 成功入口（NCKU ADFS SSO）登入設定
# 向成大資訊中心申請取得以下資訊
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
# redirect_uri 需向成大資訊中心登記，固定指向本系統的 callback endpoint
PORTAL_REDIRECT_URI=http://aidemo.ncku.edu.tw:8888/