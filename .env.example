# ============================================================================== 
# Docker 環境變數配置範例
# ============================================================================== 
# 使用說明：
# 1. 複製此檔案為 .env: cp .env.example .env
# 2. 修改敏感資訊（密碼、金鑰等）
# 3. 執行 docker compose up -d --build
# ============================================================================== 

# ==============================================================================
# Docker 建置設定
# ==============================================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ==============================================================================
# 應用程式基本設定
# ==============================================================================
APP_NAME=RAG Knowledge Base
DEBUG=False
API_V1_PREFIX=/api

# ==============================================================================
# 安全設定（⚠️ 請務必修改）
# ==============================================================================
# JWT 金鑰（請使用隨機字串，可用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==============================================================================
# PostgreSQL 資料庫設定
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=rag_db
POSTGRES_PORT=5432

# 資料庫連線池設定
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ==============================================================================
# 資料庫初始化控制
# ==============================================================================
# 首次啟動設為 true，後續可改為 false 避免重複初始化
INIT_DB=true
INIT_SYSTEM_SETTINGS=true

# ==============================================================================
# 預設管理員帳號（⚠️ 請務必修改密碼）
# ==============================================================================
# 超級管理員
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_EMAIL=superadmin@ncku.edu.tw

# 各部門管理員預設密碼
DEPT_ADMIN_PASSWORD=admin123

# ==============================================================================
# 檔案上傳設定
# ==============================================================================
# 最大檔案大小（位元組）52428800 = 50MB
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.xls,.xlsx

# ==============================================================================
# CORS 設定
# ==============================================================================
# 開發環境可用 *，生產環境建議指定具體域名
# 例如：https://rag.ncku.edu.tw,https://admin.rag.ncku.edu.tw
CORS_ORIGINS=*

# ==============================================================================
# Ollama 設定（⚠️ 請修改為您的 Ollama 伺服器位址）
# ==============================================================================
OLLAMA_BASE_URL=https://your-ollama-server-url
OLLAMA_BASE_URL_2=
OLLAMA_SUMMARY_MODEL=qwen2.5:14b
OLLAMA_RAG_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Guard 安全過濾設定
GUARD_ENABLED=true
GUARD_MODEL=llama-guard3:8b

LITELLM_ROUTING_STRATEGY=simple-shuffle
LITELLM_NUM_RETRIES=1
LITELLM_TIMEOUT=90
LITELLM_MAX_HOSTS=5

# 外部 API（OpenAI）預設模型（用於 /api/rag/direct-query）
OPENAI_DIRECT_MODEL=gpt-5.2
OPENAI_ENABLE_WEB_SEARCH=false

# ============================================================================== 
# Celery / Redis 設定
# ============================================================================== 
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2

# Flower 監控介面端口
FLOWER_PORT=5555

# Uvicorn workers（建議先維持 1，避免多進程狀態同步問題）
UVICORN_WORKERS=1

# HuggingFace 離線模式（1=啟用，0=關閉）
HF_HUB_OFFLINE=1

# ==============================================================================
# Reranker 設定
# ==============================================================================
# 本地部署（同一台 docker compose）用預設即可
# 遠端 VM 部署時改為 GPU 機器 IP，例: http://192.168.x.x:8100
# 也可直接填完整 rerank endpoint，例: https://example.com/rerank
RERANKER_API_URL=http://reranker:8100
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# API 格式：internal=本專案 reranker_server.py；tei=PrimeHub/HuggingFace TEI /rerank
RERANKER_API_FORMAT=internal

# ==============================================================================
# Frontend 建置設定
# ==============================================================================
VITE_API_BASE_URL=/api
VITE_ADMIN_BASE_PATH=/admin
VITE_QUERY_BASE_PATH=/query
VITE_GOOGLE_CLIENT_ID=

# Google 登入（後端驗證 ID Token 用）
GOOGLE_CLIENT_ID=

# 成功入口（NCKU ADFS SSO）登入
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_REDIRECT_URI=
# ==============================================================================
# Nginx 設定
# ==============================================================================
# 對外開放的端口
NGINX_PORT=80

# ==============================================================================
# 開發除錯設定（可選）
# ==============================================================================
# 設為 true 可在容器中看到更多日誌
# UVICORN_LOG_LEVEL=debug
# PYTHONUNBUFFERED=1
